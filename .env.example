# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playhive?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# Gateway
GATEWAY_URL="ws://localhost:3001"
GATEWAY_ID="gateway-1"

# TURN (coturn)
TURN_URL="turn:localhost:3478"
TURN_USERNAME="turnuser"
TURN_PASSWORD="turnpass"

# App
NODE_ENV="development"