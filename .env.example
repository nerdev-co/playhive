# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playhive?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
# Generate a production JWT secret with:
#   openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ISSUER="playhive-server"
JWT_AUDIENCE="playhive-client"
TOKEN_EXPIRY="7d"

# Gateway
WS_GATEWAY_URL="ws://localhost:3002"
GATEWAY_ID="gateway-1"

# Redis
REDIS_URL="redis://localhost:6379"

# App
NODE_ENV="development"